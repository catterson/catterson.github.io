library(car)
d <- Salaries
mod1 <- lm(d$salary ~ d$yrs.service)
coef(mod1)
par(mfrow = c(1,2))
plot(d$salary ~ d$yrs.service)
abline(mod1, lwd = 3, col = 'red')
## Adding a Quadratic Term
mod1bendy <- lm(salary ~ yrs.service + I(yrs.service^2), data = d)
coef(mod1bendy)
?I
## Adding a Quadratic Term
mod1bendy <- lm(salary ~ yrs.service + I(yrs.service^2), data = d)
coef(mod1bendy)
yrs.service_values <- seq(min(d$yrs.service), max(d$yrs.service), length.out = 100)
yrs.service_values
mod1bendy
# 4. Predict the corresponding y-values
## 85155 + 3011 * X - 51.13*X^2
predicted_salary <- predict(mod1bendy, newdata = data.frame(yrs.service = yrs.service_values))
predicted_salary
# 5. Add the quadratic line to the plot
lines(yrs.service_values, predicted_salary, col = "red", lwd = 2)
par(mfrow = c(1,2))
plot(d$salary ~ d$yrs.service)
abline(mod1, lwd = 3, col = 'red')
par(mfrow = c(1,2))
plot(d$salary ~ d$yrs.service)
abline(mod1, lwd = 3, col = 'red')
plot(d$salary ~ d$yrs.service)
lines(yrs.service_values, predicted_salary, col = "red", lwd = 2)
mod1bendy
